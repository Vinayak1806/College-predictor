generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model University {
  id       BigInt    @id @default(autoincrement())
  name     String    @unique
  colleges College[]

  @@map("universities")
}

model City {
  id       BigInt    @id @default(autoincrement())
  name     String
  district String?
  region   String?
  colleges College[]

  @@unique([name, district])
  @@map("cities")
}

model College {
  id              BigInt                @id @default(autoincrement())
  instituteCode   String                @unique @map("institute_code")
  name            String
  slug            String                @unique
  cityId          BigInt?               @map("city_id")
  universityId    BigInt?               @map("university_id")
  collegeType     String?               @map("college_type")
  autonomous      Boolean               @default(false)
  minorityType    String?               @map("minority_type")
  officialWebsite String?               @map("official_website")
  collegeBranches CollegeBranch[]
  fees            CollegeFee[]
  profile         CollegeProfile?
  rankings        CollegeRanking[]
  routeArchives   CollegeRouteArchive[]
  city            City?                 @relation(fields: [cityId], references: [id])
  university      University?           @relation(fields: [universityId], references: [id])

  @@index([cityId])
  @@map("colleges")
}

model CollegeRanking {
  id            BigInt   @id @default(autoincrement())
  instituteCode String   @map("institute_code")
  rankingSystem String   @map("ranking_system")
  rankingYear   Int      @map("ranking_year")
  category      String
  rank          Int?
  band          String?
  score         Decimal? @db.Decimal(10, 4)
  matchedName   String?  @map("matched_name")
  verified      Boolean  @default(false)
  sourceUrl     String?  @map("source_url")
  sourceFile    String?  @map("source_file")
  college       College  @relation(fields: [instituteCode], references: [instituteCode])

  @@unique([instituteCode, rankingSystem, rankingYear, category], map: "college_rankings_institute_code_ranking_system_ranking_year_cat")
  @@index([rankingSystem, rankingYear, category, rank])
  @@map("college_rankings")
}

model CollegeProfile {
  id                        BigInt   @id @default(autoincrement())
  instituteCode             String   @unique @map("institute_code")
  instituteName             String   @map("institute_name")
  currentCap2025            String?  @map("current_cap_2025")
  state                     String?
  region                    String?
  districtCity              String?  @map("district_city")
  address                   String?
  ownershipType             String?  @map("ownership_type")
  autonomyStatus            String?  @map("autonomy_status")
  minorityStatus            String?  @map("minority_status")
  university                String?
  totalIntake               Int?     @map("total_intake")
  branchRecords             Int?     @map("branch_records")
  feeYear                   String?  @map("fee_year")
  totalApprovedFee          Int?     @map("total_approved_fee")
  fePreferenceProxy         Decimal? @map("fe_preference_proxy") @db.Decimal(10, 4)
  dsePreferenceProxy        Decimal? @map("dse_preference_proxy") @db.Decimal(10, 4)
  combinedPreferenceProxy   Decimal? @map("combined_preference_proxy") @db.Decimal(10, 4)
  preferenceBand            String?  @map("preference_band")
  naacStatus                String?  @map("naac_status")
  nbaStatus                 String?  @map("nba_status")
  placementData             String?  @map("placement_data")
  officialWebsite           String?  @map("official_website")
  websiteCompletenessScore  Decimal? @map("website_completeness_score") @db.Decimal(10, 4)
  websiteCompletenessStatus String?  @map("website_completeness_status")
  dataQualityNote           String?  @map("data_quality_note")
  sourceUrl                 String?  @map("source_url")
  college                   College  @relation(fields: [instituteCode], references: [instituteCode])

  @@map("college_profiles")
}

model CollegeFee {
  id               BigInt   @id @default(autoincrement())
  academicYear     String   @map("academic_year")
  fraInstituteId   String   @map("fra_institute_id")
  instituteCode    String?  @map("institute_code")
  instituteName    String   @map("institute_name")
  district         String?
  approvalStatus   String?  @map("approval_status")
  meetingDate      String?  @map("meeting_date")
  tuitionFee       Int?     @map("tuition_fee")
  developmentFee   Int?     @map("development_fee")
  totalApprovedFee Int?     @map("total_approved_fee")
  sourceUrl        String?  @map("source_url")
  college          College? @relation(fields: [instituteCode], references: [instituteCode])

  @@unique([academicYear, fraInstituteId])
  @@index([instituteCode])
  @@map("college_fees")
}

model Branch {
  id              BigInt          @id @default(autoincrement())
  branchCode      String          @unique @map("branch_code")
  officialName    String          @map("official_name")
  displayName     String          @map("display_name")
  searchGroup     String?         @map("search_group")
  collegeBranches CollegeBranch[]

  @@map("branches")
}

model CollegeBranch {
  id           BigInt      @id @default(autoincrement())
  collegeId    BigInt      @map("college_id")
  branchId     BigInt      @map("branch_id")
  academicYear String      @map("academic_year")
  intake       Int?
  branch       Branch      @relation(fields: [branchId], references: [id])
  college      College     @relation(fields: [collegeId], references: [id])
  cutoffs      Cutoff[]
  shortlists   Shortlist[]

  @@unique([collegeId, branchId, academicYear])
  @@map("college_branches")
}

model SeatType {
  id             BigInt   @id @default(autoincrement())
  code           String   @unique
  category       String
  gender         String
  universityType String   @map("university_type")
  specialType    String?  @map("special_type")
  cutoffs        Cutoff[]

  @@index([code, category])
  @@map("seat_types")
}

model CutoffDataset {
  id                BigInt    @id @default(autoincrement())
  academicYear      String    @map("academic_year")
  admissionRoute    String    @map("admission_route")
  capRound          Int       @map("cap_round")
  quota             String
  sourceFilename    String    @map("source_filename")
  sourceUrl         String?   @map("source_url")
  fileHash          String?   @map("file_hash")
  status            String
  importedAt        DateTime  @default(now()) @map("imported_at")
  verifiedAt        DateTime? @map("verified_at")
  predictionEnabled Boolean   @default(true) @map("prediction_enabled")
  historyEnabled    Boolean   @default(true) @map("history_enabled")
  archivedAt        DateTime? @map("archived_at")
  cutoffs           Cutoff[]

  @@index([admissionRoute, academicYear, capRound, quota, status])
  @@map("cutoff_datasets")
}

model CollegeRouteArchive {
  id             BigInt   @id @default(autoincrement())
  collegeId      BigInt   @map("college_id")
  admissionRoute String   @map("admission_route")
  reason         String?
  archivedAt     DateTime @default(now()) @map("archived_at")
  college        College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, admissionRoute])
  @@index([admissionRoute, archivedAt])
  @@map("college_route_archives")
}

model Cutoff {
  id              BigInt        @id @default(autoincrement())
  datasetId       BigInt        @map("dataset_id")
  collegeBranchId BigInt        @map("college_branch_id")
  seatTypeId      BigInt        @map("seat_type_id")
  stage           String?
  openingRank     Int?          @map("opening_rank")
  closingRank     Int?          @map("closing_rank")
  openingScore    Decimal?      @map("opening_score") @db.Decimal(10, 7)
  closingScore    Decimal?      @map("closing_score") @db.Decimal(10, 7)
  sourcePage      Int           @map("source_page")
  verified        Boolean       @default(false)
  needsReview     Boolean       @default(true) @map("needs_review")
  reviewReason    String?       @map("review_reason")
  section         String        @default("STANDARD")
  collegeBranch   CollegeBranch @relation(fields: [collegeBranchId], references: [id])
  dataset         CutoffDataset @relation(fields: [datasetId], references: [id])
  seatType        SeatType      @relation(fields: [seatTypeId], references: [id])

  @@unique([datasetId, collegeBranchId, seatTypeId, stage, section])
  @@index([closingScore])
  @@index([closingRank])
  @@index([datasetId, collegeBranchId, seatTypeId])
  @@map("cutoffs")
}

model SeatMatrix {
  id                BigInt  @id @default(autoincrement())
  academicYear      String  @map("academic_year")
  admissionRoute    String  @map("admission_route")
  instituteCode     String  @map("institute_code")
  collegeName       String  @map("college_name")
  collegeStatus     String? @map("college_status")
  collegeType       String? @map("college_type")
  autonomous        Boolean @default(false)
  capSeats          Int?    @map("cap_seats")
  branchCode        String  @map("branch_code")
  branchName        String  @map("branch_name")
  sanctionedIntake  Int?    @map("sanctioned_intake")
  maharashtraSeats  Int?    @map("maharashtra_seats")
  minoritySeats     Int?    @map("minority_seats")
  allIndiaSeats     Int?    @map("all_india_seats")
  instituteSeats    Int?    @map("institute_seats")
  orphanSeats       Int?    @map("orphan_seats")
  ewsSeats          Int?    @map("ews_seats")
  tfwsChoiceCode    String? @map("tfws_choice_code")
  tfwsSeats         Int?    @map("tfws_seats")
  sourceFile        String  @map("source_file")
  sourcePage        Int     @map("source_page")
  verified          Boolean @default(false)
  needsReview       Boolean @default(false) @map("needs_review")
  reviewReason      String? @map("review_reason")
  vacantSeats       Int?    @map("vacant_seats")
  lateralEntrySeats Int?    @map("lateral_entry_seats")
  pwdSeats          Int?    @map("pwd_seats")
  defenceSeats      Int?    @map("defence_seats")
  categorySeats     Json?   @map("category_seats")

  @@unique([academicYear, admissionRoute, branchCode])
  @@index([academicYear, branchCode])
  @@index([instituteCode])
  @@index([sanctionedIntake, capSeats])
  @@map("seat_matrices")
}

model User {
  id                Int                 @id @default(autoincrement())
  email             String              @unique
  role              String              @default("STUDENT")
  createdAt         DateTime            @default(now()) @map("created_at")
  name              String
  emailVerified     Boolean             @default(false) @map("email_verified")
  image             String?
  updatedAt         DateTime            @default(now()) @updatedAt @map("updated_at")
  predictionHistory PredictionHistory[]
  preferenceLists   PreferenceList[]
  savedComparisons  SavedComparison[]
  shortlists        Shortlist[]
  studentProfiles   StudentProfile[]
  accounts          Account[]
  sessions          Session[]

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    Int      @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Account {
  id                    Int       @id @default(autoincrement())
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                Int       @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("user_accounts")
}

model Verification {
  id         Int      @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("auth_verifications")
}

model RateLimit {
  id          Int    @id @default(autoincrement())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("auth_rate_limits")
}

model AdminSession {
  id            BigInt   @id @default(autoincrement())
  tokenHash     String   @unique @map("token_hash")
  expiresAt     DateTime @map("expires_at")
  createdAt     DateTime @default(now()) @map("created_at")
  lastUsedAt    DateTime @default(now()) @map("last_used_at")
  ipHash        String?  @map("ip_hash")
  userAgentHash String?  @map("user_agent_hash")

  @@index([expiresAt])
  @@map("admin_sessions")
}

model Shortlist {
  id              BigInt        @id @default(autoincrement())
  userId          Int           @map("user_id")
  collegeBranchId BigInt        @map("college_branch_id")
  createdAt       DateTime      @default(now()) @map("created_at")
  collegeBranch   CollegeBranch @relation(fields: [collegeBranchId], references: [id])
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeBranchId])
  @@index([userId, createdAt])
  @@map("shortlists")
}

model PreferenceList {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("preference_lists")
}

model SavedComparison {
  id        BigInt   @id @default(autoincrement())
  userId    Int      @map("user_id")
  name      String
  items     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("saved_comparisons")
}

model StudentProfile {
  id             BigInt   @id @default(autoincrement())
  userId         Int      @map("user_id")
  name           String
  admissionRoute String   @map("admission_route")
  formData       Json     @map("form_data")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, admissionRoute, name])
  @@index([userId, admissionRoute, updatedAt])
  @@map("student_profiles")
}

model PredictionHistory {
  id             BigInt   @id @default(autoincrement())
  userId         Int      @map("user_id")
  admissionRoute String   @map("admission_route")
  formData       Json     @map("form_data")
  resultCount    Int      @default(0) @map("result_count")
  zoneCounts     Json?    @map("zone_counts")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, admissionRoute, createdAt])
  @@map("prediction_history")
}

model AdminImport {
  id               BigInt              @id @default(autoincrement())
  documentType     String              @map("document_type")
  admissionRoute   String?             @map("admission_route")
  academicYear     String?             @map("academic_year")
  capRound         Int?                @map("cap_round")
  quota            String?
  originalFilename String              @map("original_filename")
  storedPath       String              @map("stored_path")
  mimeType         String?             @map("mime_type")
  fileSize         Int                 @map("file_size")
  fileHash         String              @unique @map("file_hash")
  sourceUrl        String?             @map("source_url")
  status           String
  summary          Json?
  errorMessage     String?             @map("error_message")
  createdAt        DateTime            @default(now()) @map("created_at")
  processedAt      DateTime?           @map("processed_at")
  publishedAt      DateTime?           @map("published_at")
  rolledBackAt     DateTime?           @map("rolled_back_at")
  records          AdminImportRecord[]

  @@index([status, createdAt])
  @@map("admin_imports")
}

model AdminImportRecord {
  id                BigInt      @id @default(autoincrement())
  importId          BigInt      @map("import_id")
  rowNumber         Int         @map("row_number")
  recordType        String      @map("record_type")
  data              Json
  valid             Boolean     @default(false)
  needsReview       Boolean     @default(true) @map("needs_review")
  issues            Json?
  publishedRecordId BigInt?     @map("published_record_id")
  adminImport       AdminImport @relation(fields: [importId], references: [id], onDelete: Cascade)

  @@unique([importId, rowNumber])
  @@index([importId, valid, needsReview])
  @@map("admin_import_records")
}
