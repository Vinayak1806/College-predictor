{
  "name": "college-predictor-application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/start-dev.js",
    "build": "next build",
    "start": "next start",
    "test": "node --test lib/*.test.js",
    "test:smoke": "node scripts/smoke-test.js",
    "test:routes": "node --env-file=.env scripts/route-audit.js",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:load": "node scripts/load-test.js",
    "backup:db": "powershell -ExecutionPolicy Bypass -File scripts/backup-database.ps1",
    "restore:test": "powershell -ExecutionPolicy Bypass -File scripts/test-database-restore.ps1",
    "restore:staging": "powershell -ExecutionPolicy Bypass -File scripts/restore-staging-database.ps1",
    "check:config": "node scripts/predeploy-check.js",
    "check:deploy": "pnpm check:config && pnpm test && pnpm build",
    "monitor:production": "node scripts/monitor-production.js",
    "check:launch": "pnpm check:deploy",
    "test:backtest": "node scripts/run-prediction-backtests.js",
    "lint": "next lint",
    "data:universities": "node scripts/enrich-university-affiliations.js",
    "data:universities:apply": "node scripts/enrich-university-affiliations.js --apply",
    "data:reviewed-institutes": "node scripts/import-reviewed-institutes.js",
    "data:reviewed-institutes:apply": "node scripts/import-reviewed-institutes.js --apply",
    "data:seat-matrix-fixes": "node scripts/import-seat-matrix-fixes.js",
    "data:seat-matrix-fixes:apply": "node scripts/import-seat-matrix-fixes.js --apply",
    "data:fees": "node scripts/enrich-fra-fees.js",
    "data:fees:apply": "node scripts/enrich-fra-fees.js --apply",
    "data:cutoff-sources": "node scripts/attach-official-cutoff-sources.js",
    "data:cutoff-sources:apply": "node scripts/attach-official-cutoff-sources.js --apply",
    "data:dse-enrichment": "node scripts/import-dse-college-dataset.js",
    "data:dse-enrichment:apply": "node scripts/import-dse-college-dataset.js --apply",
    "admin:reprocess": "node --env-file=.env scripts/reprocess-admin-import.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.6.25",
    "@fontsource-variable/inter": "^5.3.0",
    "@prisma/client": "^6.0.0",
    "@sentry/nextjs": "^10.70.0",
    "better-auth": "^1.6.25",
    "lucide-react": "^1.25.0",
    "next": "^15.5.21",
    "pdf-lib": "^1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.53.0",
    "recharts": "^2.13.0",
    "sharp": "0.35.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.18",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17"
  }
}
